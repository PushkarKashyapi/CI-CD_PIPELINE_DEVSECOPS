{
  "name": "tes",
  "version": "1.0.0",
  "description": "a testing app",
  "license": "ISC",
  "author": "Pushkar Kashyapi",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "build": "node --check src/server.js && node --check src/app.js"
  },
  "overrides": {
    "deepmerge": "^4.3.1",
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  },
  "dependencies": {
    "express": "^5.3.0",
    "vibeshield-nodejs-backend": "^0.1.4"
  },
  "allowScripts": {
    "vibeshield-nodejs-backend@0.1.0": true
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.0.0"
  }
}
